---
import Base from '../layouts/Base.astro';
import HeroMap from '../components/HeroMap.astro';
import Counters from '../components/Counters.astro';
import HomeAnalytics from '../components/HomeAnalytics.astro';
import Workbench from '../components/Workbench.astro';
import { work } from '../data/work.js';
import { embeds } from '../data/embeds.js';

const reports = [
  {
    slug: 'program-kpi',
    title: 'Program KPI',
    text: 'Field visits, outplanting, contracts and farmer status for 35 project units. In production it reads Salesforce directly.',
    stat: ['345', 'measures'],
  },
  {
    slug: 'nursery-stock',
    title: 'Nursery stock',
    text: 'A weekly nursery log turned into nine pages that show which counts are fresh, which were copied forward and which are missing.',
    stat: ['9', 'pages'],
  },
  {
    slug: 'retail-analytics',
    title: 'Retail analytics',
    text: 'Six pages on the public Superstore sample. Every number is defined once, as a named measure.',
    stat: ['22', 'measures'],
  },
];
---

<Base
  title="Elly Otieno - GIS and data analyst"
  description="GIS and data analyst in Nairobi. Interactive maps, spatial models, Power BI dashboards and field data systems for agroforestry and carbon programmes."
>
  <HeroMap />
  <Counters />
  <HomeAnalytics />
  <Workbench />

  <section class="wrap pbi" aria-labelledby="pbi-h">
    <div class="pbi-head">
      <p class="label">Power BI</p>
      <h2 id="pbi-h">Three Power BI reports you can open.</h2>
      <p class="lede">
        Two ran a live programme and one is a practice build on public data. The programme reports are rebuilt here on
        generated data, with the same pages and the same counting rules.
      </p>
    </div>
    <ul class="reports">
      {
        reports.map((r) => (
          <li>
            <a href={`/work/${r.slug}/`}>
              <span class="big">{r.stat[0]}</span>
              <span class="label">{r.stat[1]}</span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
              <span class="go label">{embeds[r.slug] ? 'Open the live Power BI report' : 'Open the interactive version'}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap" id="work" aria-labelledby="work-h">
    <h2 class="label" id="work-h">Selected work</h2>
    <ol class="work">
      {
        work.map((w, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div class="title">
              <h3>
                <a href={`/work/${w.slug}/`}>{w.title}</a>
              </h3>
              <p>{w.text}</p>
              <span class="label">{w.meta}</span>
            </div>
            <div class="stat">
              <b>{w.stat[0]}</b>
              <span class="label">{w.stat[1]}</span>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="all">
      <a href="/work/">All work, including shorter projects</a>
    </p>
  </section>

  <section class="wrap split" id="about" aria-labelledby="about-h">
    <h2 class="label" id="about-h">About</h2>
    <div class="prose">
      <p>
        From May 2023 to December 2026 I was GIS and Data Analyst at Trees for the Future, on a programme that runs in
        Kenya, Uganda, Tanzania, Mali and Senegal. In Kenya that meant about 18,000 partner farmers and 17,436 farm
        polygons across 35 project units. Before that I spent three years as a GIS Analyst at Oakar Services in Nairobi.
      </p>
      <p>
        I hold a BTech in Geoinformation Technology from the Technical University of Kenya and a Remote Pilot Licence
        from the Kenya Civil Aviation Authority.
      </p>
      <p class="note">
        Trees for the Future's data is not mine to publish. The maps and dashboards here run on generated data or a
        public sample, and each one says which. The methods and the results quoted in the text are real.
      </p>
      <p><a href="/about/">How I got into this work</a></p>
    </div>
  </section>

  <section class="wrap split" id="contact" aria-labelledby="contact-h">
    <h2 class="label" id="contact-h">Contact</h2>
    <div>
      <a class="mail" href="mailto:eliotieno.ol@gmail.com">eliotieno.ol@gmail.com</a>
      <p class="links">
        <a href="https://www.linkedin.com/in/ellyotieno/">LinkedIn</a>
        <a href="https://github.com/eliotieno">GitHub</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .pbi {
    padding-block: clamp(2rem, 5vw, 4rem) var(--section);
  }

  .pbi-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .pbi-head h2 {
    font-size: clamp(2rem, 4.6vw, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  .lede {
    max-width: 52ch;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
  }

  .reports {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .reports a {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--bg);
    text-decoration: none;
    transition: background 0.2s;
  }

  .reports a:hover {
    background: var(--panel);
    color: inherit;
  }

  .reports .big {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
  }

  .reports h3 {
    margin-top: 1rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .reports p {
    color: var(--muted);
  }

  .reports .go {
    margin-top: 1rem;
    color: var(--ink);
  }

  .reports a:hover .go {
    color: var(--accent);
  }

  .work {
    margin-top: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .work li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 7fr) minmax(0, 4fr);
    column-gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.5rem, 3.5vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .num {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--accent);
  }

  .title {
    display: grid;
    gap: 0.6rem;
  }

  h3 {
    font-size: clamp(1.6rem, 3.6vw, 3rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  h3 a {
    text-decoration: none;
  }

  .work p {
    max-width: 48ch;
    color: var(--muted);
  }

  .stat {
    text-align: right;
  }

  .stat b {
    display: block;
    font-size: clamp(2rem, 4.5vw, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .all {
    margin-top: 1.5rem;
    padding-bottom: var(--section);
  }

  .mail {
    display: inline-block;
    font-size: clamp(1.45rem, 5.4vw, 4.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  #contact {
    padding-top: 0;
  }

  @media (max-width: 860px) {
    .reports {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .work li {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      row-gap: 1rem;
    }

    .stat {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
