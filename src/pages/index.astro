---
import Base from '../layouts/Base.astro';

import { work } from '../data/work.js';

// Hero figure: generated farms joined to their nearest site. Seeded so every build draws the same picture.
function mulberry32(seed) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(2026);
const gauss = () => (rand() + rand() + rand() + rand() - 2) / 2; // roughly -1..1, centre-heavy
const W = 640;
const H = 400;
const sites = [
  [110, 110], [300, 80], [520, 120], [170, 290], [380, 250], [560, 310],
].map(([x, y]) => [x + gauss() * 20, y + gauss() * 20]);
const farms = Array.from({ length: 170 }, () => {
  const [sx, sy] = sites[Math.floor(rand() * sites.length)];
  const x = Math.min(W - 8, Math.max(8, sx + gauss() * 105));
  const y = Math.min(H - 8, Math.max(8, sy + gauss() * 85));
  const nearest = sites.reduce((a, b) => (Math.hypot(b[0] - x, b[1] - y) < Math.hypot(a[0] - x, a[1] - y) ? b : a));
  return { x, y, nearest };
});
const r1 = (n) => n.toFixed(1);
---

<Base
  title="Elly Otieno - GIS and data analyst"
  description="GIS and data analyst in Nairobi. Field data systems, spatial models and dashboards for agroforestry and carbon programmes."
>
  <section class="wrap hero">
    <h1>
      I work out <em>where a thing should go</em> using data that already exists, then check it against the ground.
    </h1>
    <div class="hero-row">
      <figure>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Generated farm points, each joined by a line to its nearest nursery site">
          {farms.map((f) => <line x1={r1(f.x)} y1={r1(f.y)} x2={r1(f.nearest[0])} y2={r1(f.nearest[1])} />)}
          {farms.map((f) => <circle class="farm" cx={r1(f.x)} cy={r1(f.y)} r="2.2" />)}
          {sites.map(([x, y]) => <circle class="site" cx={r1(x)} cy={r1(y)} r="7" />)}
        </svg>
        <figcaption class="label">170 generated farms, each assigned to its nearest of six sites. No real locations.</figcaption>
      </figure>
      <p class="intro">
        GIS and data analyst in Nairobi. I build field data systems, spatial models and dashboards for agroforestry and
        carbon programmes.
      </p>
    </div>
  </section>

  <section class="wrap" id="work" aria-labelledby="work-h">
    <h2 class="label" id="work-h">Selected work</h2>
    <ol class="work">
      {
        work.map((w, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>
              <a href={`/work/${w.slug}/`}>{w.title}</a>
            </h3>
            <p>{w.text}</p>
            <span class="label">{w.meta}</span>
          </li>
        ))
      }
    </ol>
    <p class="all">
      <a href="/work/">All work, including shorter projects</a>
    </p>
  </section>

  <section class="wrap split" id="about" aria-labelledby="about-h">
    <h2 class="label" id="about-h">About</h2>
    <div class="prose">
      <p>
        From May 2023 to December 2026 I was GIS and Data Analyst at Trees for the Future, on a programme that runs in
        Kenya, Uganda, Tanzania, Mali and Senegal. In Kenya that meant about 18,000 partner farmers and 17,436 farm
        polygons across 35 project units. Before that I spent three years as a GIS Analyst at Oakar Services in Nairobi.
      </p>
      <p>
        I hold a BTech in Geoinformation Technology from the Technical University of Kenya and a Remote Pilot Licence
        from the Kenya Civil Aviation Authority.
      </p>
      <p class="note">
        Trees for the Future's data is not mine to publish. The maps and dashboards here run on generated data or a
        public sample, and each one says which. The methods and the results quoted in the text are real.
      </p>
      <p><a href="/about/">How I got into this work</a></p>
    </div>
  </section>

  <section class="wrap split" id="contact" aria-labelledby="contact-h">
    <h2 class="label" id="contact-h">Contact</h2>
    <div>
      <a class="mail" href="mailto:eliotieno.ol@gmail.com">eliotieno.ol@gmail.com</a>
      <p class="links">
        <a href="https://www.linkedin.com/in/ellyotieno/">LinkedIn</a>
        <a href="https://github.com/eliotieno">GitHub</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) var(--section);
  }

  h1 {
    font-size: clamp(2.35rem, 6.6vw, 6.25rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 17ch;
    text-wrap: balance;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  line {
    stroke: var(--line);
    stroke-width: 1;
  }

  .farm {
    fill: var(--muted);
  }

  .site {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 3;
  }

  figcaption {
    margin-top: 0.75rem;
  }

  .intro {
    font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    max-width: 24ch;
  }

  .work {
    margin-top: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .work li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 6fr) minmax(0, 5fr);
    column-gap: clamp(1rem, 3vw, 3rem);
    row-gap: 0.5rem;
    align-items: baseline;
    padding-block: clamp(1.5rem, 3.5vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .num {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--accent);
  }

  h3 {
    font-size: clamp(1.6rem, 3.8vw, 3.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  h3 a {
    text-decoration: none;
  }

  .all {
    margin-top: 1.5rem;
  }

  .work p {
    max-width: 44ch;
    color: var(--muted);
  }

  .work .label {
    grid-column: 3;
  }


  .mail {
    display: inline-block;
    font-size: clamp(1.45rem, 5.4vw, 4.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  #contact {
    padding-top: 0;
  }

  @media (max-width: 760px) {
    .hero-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .work li {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .work p,
    .work .label {
      grid-column: 2;
    }
  }
</style>
