---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource/fragment-mono/latin-400.css';
import '../styles/tokens.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#0b0d0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap top">
      <a class="name" href="/"><img src="/brand/mark-on-dark.svg" alt="" width="28" height="28" />Elly Otieno</a>
      <nav aria-label="Main">
        <a href="/work/">Work</a>
        <a href="/about/">About</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap foot label">
      <span>Nairobi, Kenya</span>
      <span>Demos run on generated or public sample data</span>
      <a href="https://github.com/eliotieno/elly-portfolio">Source code</a>
    </footer>
  </body>
</html>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: center;
    font-weight: 650;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  nav a {
    text-decoration: none;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }
</style>
