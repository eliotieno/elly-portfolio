---
import 'maplibre-gl/dist/maplibre-gl.css';
import data from '../../public/data/nursery.json';

const limits = ['30', '20', '10'];
const rows = limits.map((l) => ({ limit: l, ...data.scenarios[l].stats }));
---

<section class="demo" data-nursery aria-labelledby="nursery-h">
  <div class="demo-head">
    <h2 class="label" id="nursery-h">Nursery network on {data.farms.length.toLocaleString('en')} generated farms</h2>
    <fieldset class="controls">
      <legend class="label">Longest walk allowed</legend>
      {
        limits.map((l, i) => (
          <label>
            <input type="radio" name="limit" value={l} checked={i === 0} /> {l} min
          </label>
        ))
      }
    </fieldset>
  </div>
  <div class="map" data-map>
    <noscript><p class="demo-body">The map needs JavaScript. The table below holds the same results.</p></noscript>
  </div>
  <div class="scroll">
    <table class="data">
      <thead>
        <tr>
          <th>Longest walk</th>
          <th>Sites</th>
          <th>Farms per site</th>
          <th>Average walk</th>
          <th>90th percentile</th>
          <th>Average distance</th>
          <th>Second site in range</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td>{r.limit} min</td>
              <td>{r.sites}</td>
              <td>{r.farmsPerSite}</td>
              <td>{r.avgMin} min</td>
              <td>{r.p90Min} min</td>
              <td>{r.avgMetres.toLocaleString('en')} m</td>
              <td>{r.secondOptionPct}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="demo-foot label">
    Generated farms and generated terrain. Green dots are nursery sites, grey dots are farms, lines join each farm to its
    site. No real locations.
  </p>
</section>

<style>
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  legend {
    float: left;
    padding: 0;
    margin-right: 1rem;
  }
</style>

<script>
  import { ACCENT, GREY, INK, boundsOf, loadMap, makeMap, whenVisible } from '../lib/demo.js';

  const root = document.querySelector('[data-nursery]');
  const fc = (features) => ({ type: 'FeatureCollection', features });
  const point = (c) => ({ type: 'Feature', properties: {}, geometry: { type: 'Point', coordinates: c } });

  whenVisible(root, async () => {
    const [gl, data] = await Promise.all([loadMap(), fetch('/data/nursery.json').then((r) => r.json())]);
    const map = makeMap(gl, root.querySelector('[data-map]'), boundsOf(data.farms));

    const layers = (limit) => {
      const { sites, assign } = data.scenarios[limit];
      return {
        sites: fc(sites.map((s) => point(data.farms[s]))),
        links: fc(
          data.farms.map((f, i) => ({
            type: 'Feature',
            properties: {},
            geometry: { type: 'LineString', coordinates: [f, data.farms[sites[assign[i]]]] },
          })),
        ),
      };
    };

    map.on('load', () => {
      const first = layers('30');
      map.addSource('links', { type: 'geojson', data: first.links });
      map.addSource('farms', { type: 'geojson', data: fc(data.farms.map(point)) });
      map.addSource('sites', { type: 'geojson', data: first.sites });
      map.addLayer({ id: 'links', type: 'line', source: 'links', paint: { 'line-color': INK, 'line-opacity': 0.18, 'line-width': 0.6 } });
      map.addLayer({
        id: 'farms',
        type: 'circle',
        source: 'farms',
        paint: { 'circle-color': GREY, 'circle-radius': ['interpolate', ['linear'], ['zoom'], 8, 1.2, 13, 3.5] },
      });
      map.addLayer({
        id: 'sites',
        type: 'circle',
        source: 'sites',
        paint: {
          'circle-color': ACCENT,
          'circle-stroke-color': '#ffffff',
          'circle-stroke-width': 1,
          'circle-radius': ['interpolate', ['linear'], ['zoom'], 8, 2.5, 13, 7],
        },
      });

      root.addEventListener('change', (e) => {
        if (e.target.name !== 'limit') return;
        const next = layers(e.target.value);
        map.getSource('links').setData(next.links);
        map.getSource('sites').setData(next.sites);
      });
    });
  });
</script>
